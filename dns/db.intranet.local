$TTL    604800
@       IN      SOA     ns1.intranet.local. root.intranet.local. (
                              2         ; Serial
                         604800         ; Refresh
                          86400         ; Retry
                        2419200         ; Expire
                         604800 )       ; Negative Cache TTL
;
@       IN      NS      ns1.intranet.local.
ns1     IN      A       192.168.10.30

; Registros obligatorios del Router
R-NCC   IN      A       192.168.10.1
R       IN      A       192.168.10.1
